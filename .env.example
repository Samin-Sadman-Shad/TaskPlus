# Copy to .env and fill in. Generate strong random values for every <generated> entry.
COMPOSE_PROJECT_NAME=smarttask

# Host ports (from src/SmartTask.Api/Properties/launchSettings.json; SQL Server default)
API_HTTP_PORT=5180
API_HTTPS_PORT=7180
SQL_PORT=1433

# SQL Server data lives outside the repo, so it survives "docker compose down"
SQLSERVER_DATA_DIR=D:/Projects/TaskPlus/sqlserver-data

# sa is used only by the init script; the app connects as APP_DB_USER
MSSQL_SA_PASSWORD=<generated>
APP_DB_NAME=SmartTaskDb
APP_DB_USER=Samin
APP_DB_PASSWORD=<app login password>

JWT_SIGNING_KEY=<generated>

# Dev HTTPS certificate for Kestrel (dotnet dev-certs https -ep ...)
CERT_PASSWORD=<generated>
CERT_DIR=C:/Users/<you>/.aspnet/https

# Optional: GitHub Models key; empty = Fake AI provider
AI_API_KEY=
